# Serviço Python executado no mesmo computador
BACKEND_URL=http://127.0.0.1:8000
# Opcional: caminho explícito. Vazio descobre /products/ pelo openapi.json.
PRODUCTS_PATH=
# Opcional: força a rota que relaciona produtos por fabricante/marca (by-brands).
PRODUCTS_BY_BRANDS_PATH=
# Opcional: token enviado somente pelo servidor Next.js
BACKEND_TOKEN=
# Banco de custos e fabricantes, criado automaticamente
FINANCE_DB_PATH=./data/finance.sqlite

# Raio-X de anúncios (opcionais)
# Google Shopping: compara Shopee, Amazon, Magalu e outras fontes retornadas pela busca
SERPAPI_KEY=
# Mercado Livre: busca concorrentes diretamente pela API oficial
MELI_ACCESS_TOKEN=
# Evita gastar consultas repetidas (padrão: 360 minutos)
MARKET_CACHE_MINUTES=360

# Obrigatório para liberar o login. Configure no servidor Next.js, nunca NEXT_PUBLIC_*.
# Rode: node scripts/hash-password.mjs
# Depois copie os valores GERADOS para o ambiente do processo Next.js e reinicie.
AUTH_EMAIL=FluxHub@gmail.com
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=
