# Serviço Python executado no mesmo computador
BACKEND_URL=http://127.0.0.1:8000
# Opcional: caminho explícito. Vazio descobre /products/ pelo openapi.json.
PRODUCTS_PATH=
# Opcional: força a rota que relaciona produtos por fabricante/marca (by-brands).
PRODUCTS_BY_BRANDS_PATH=
# OBRIGATÓRIO para consultar o FastAPI protegido. Mesmo valor de BACKEND_TOKEN no backend.
# Gere: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Configure APENAS no servidor, nunca use NEXT_PUBLIC_.
BACKEND_TOKEN=
# Nenhum SQLite no Next.js. Custos e usuários vêm exclusivamente do backend PostgreSQL.

# Raio-X de anúncios (opcionais)
# Google Shopping: compara Shopee, Amazon, Magalu e outras fontes retornadas pela busca
SERPAPI_KEY=
# Mercado Livre: busca concorrentes diretamente pela API oficial
MELI_ACCESS_TOKEN=
# Evita gastar consultas repetidas (padrão: 360 minutos)
MARKET_CACHE_MINUTES=360

# Login validado exclusivamente por POST /api/v1/auth/login (FastAPI/PostgreSQL).
# Segredo local usado APENAS para cifrar o cookie HttpOnly que contém o JWT.
AUTH_SESSION_SECRET=
